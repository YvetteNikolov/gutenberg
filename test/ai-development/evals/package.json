{
	"name": "gutenberg-agent-skill-evals",
	"private": true,
	"type": "module",
	"description": "Promptfoo evals that verify agent skills in this repository are discovered, followed, and produce output that meets our rules.",
	"scripts": {
		"test:grader": "node scripts/test-grader.mjs",
		"eval:claude": "promptfoo eval --config promptfooconfig.pr-skill.claude.yaml --no-cache",
		"eval:codex": "promptfoo eval --config promptfooconfig.pr-skill.codex.yaml --no-cache",
		"view": "promptfoo view"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.211",
		"@openai/codex-sdk": "^0.144.5",
		"promptfoo": "^0.121.19"
	}
}
