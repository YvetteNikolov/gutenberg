{
	"name": "@wordpress/agent-skill-evals",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Promptfoo evals that verify agent skills in this repository are discovered, followed, and produce output that meets our rules.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/test/ai-development/evals",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/gutenberg.git",
		"directory": "test/ai-development/evals"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"scripts": {
		"validate": "promptfoo validate config",
		"eval": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_FAILED_TEST_EXIT_CODE=0 promptfoo eval --no-cache",
		"eval:claude": "npm run eval -- --filter-providers claude",
		"eval:codex": "npm run eval -- --filter-providers codex",
		"view": "promptfoo view"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.201",
		"@openai/codex-sdk": "^0.144.6",
		"promptfoo": "^0.121.19"
	}
}
