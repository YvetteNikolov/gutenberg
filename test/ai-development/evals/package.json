{
	"name": "@wordpress/agent-skill-evals",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Promptfoo evals that verify agent skills in this repository are discovered, followed, and produce output that meets our rules.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/WordPress/gutenberg/tree/HEAD/test/ai-development/evals",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/gutenberg.git",
		"directory": "test/ai-development/evals"
	},
	"bugs": {
		"url": "https://github.com/WordPress/gutenberg/issues"
	},
	"scripts": {
		"validate:pull-requests": "promptfoo validate --config pull-requests/promptfooconfig.claude.yaml && promptfoo validate --config pull-requests/promptfooconfig.codex.yaml",
		"eval:pull-requests:claude": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_FAILED_TEST_EXIT_CODE=0 promptfoo eval --config pull-requests/promptfooconfig.claude.yaml --no-cache",
		"eval:pull-requests:codex": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_FAILED_TEST_EXIT_CODE=0 promptfoo eval --config pull-requests/promptfooconfig.codex.yaml --no-cache",
		"report": "node shared/summarize-results.mjs results/raw/pull-requests-claude.json results/raw/pull-requests-codex.json",
		"view": "promptfoo view"
	},
	"engines": {
		"node": "^20.20.0 || >=22.22.0"
	},
	"devDependencies": {
		"promptfoo": "^0.121.19"
	}
}
